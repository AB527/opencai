# Postgres connection string -- points at a Postgres instance you run yourself.
DATABASE_URL=postgresql://opencai:opencai@localhost:5432/opencai?schema=public

# JWT signing secret -- generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=changeme-generate-a-long-random-string

# Master key for envelope-encrypting stored credentials/TOTP secrets (32 bytes) --
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_ENCRYPTION_KEY=changeme-32-byte-base64-key

PORT=5271
NODE_ENV=development

TOTP_ISSUER_NAME=OpenCAI

# MinIO / S3-compatible object storage -- points at an instance you run yourself.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
S3_BUCKET=opencai

# Optional -- only needed when the browser can't resolve the same hostname the
# backend uses internally to reach S3/MinIO (e.g. the containerized run, where
# S3_ENDPOINT is a compose-network-only hostname). Defaults to S3_ENDPOINT when unset.
S3_PUBLIC_URL=

# Optional -- only needed when the frontend and backend are served from different
# origins (e.g. the containerized run). When unset, CORS falls back to allowing
# all origins outside production and none in production.
CORS_ORIGIN=

# Optional, only read by `npm run prisma:seed`: sets the master admin's initial
# password. If unset, defaults to "admin" -- change it (via the app's own
# change-password flow) before exposing the instance beyond localhost.
SEED_ADMIN_PASSWORD=
